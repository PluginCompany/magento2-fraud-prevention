<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">plugincompany_fraudprevention_rule_form.rule_form_data_source</item>
			<item name="deps" xsi:type="string">plugincompany_fraudprevention_rule_form.rule_form_data_source</item>
		</item>
		<item name="label" translate="true" xsi:type="string">General Information</item>
		<item name="config" xsi:type="array">
			<item name="dataScope" xsi:type="string">data</item>
			<item name="namespace" xsi:type="string">plugincompany_fraudprevention_rule_form</item>
		</item>
		<item name="template" xsi:type="string">templates/form/collapsible</item>
		<item name="buttons" xsi:type="array">
			<item name="back" xsi:type="string">PluginCompany\FraudPrevention\Block\Adminhtml\Rule\Edit\BackButton</item>
			<item name="delete" xsi:type="string">PluginCompany\FraudPrevention\Block\Adminhtml\Rule\Edit\DeleteButton</item>
			<item name="save" xsi:type="string">PluginCompany\FraudPrevention\Block\Adminhtml\Rule\Edit\SaveButton</item>
			<item name="save_and_continue" xsi:type="string">PluginCompany\FraudPrevention\Block\Adminhtml\Rule\Edit\SaveAndContinueButton</item>
		</item>
	</argument>
	<dataSource name="rule_form_data_source">
		<argument name="dataProvider" xsi:type="configurableObject">
			<argument name="class" xsi:type="string">PluginCompany\FraudPrevention\Model\Rule\DataProvider</argument>
			<argument name="name" xsi:type="string">rule_form_data_source</argument>
			<argument name="primaryFieldName" xsi:type="string">rule_id</argument>
			<argument name="requestFieldName" xsi:type="string">rule_id</argument>
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="submit_url" path="*/*/save" xsi:type="url"/>
				</item>
			</argument>
		</argument>
		<argument name="data" xsi:type="array">
			<item name="js_config" xsi:type="array">
				<item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
			</item>
		</argument>
	</dataSource>
	<fieldset name="General">
		<argument name="data" xsi:type="array">
			<item name="config" xsi:type="array">
				<item name="label" xsi:type="string">Rule Settings</item>
				<item name="collapsible" xsi:type="boolean">false</item>
			</item>
		</argument>
		<field name="name">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="dataType" xsi:type="string">text</item>
					<item name="label" translate="true" xsi:type="string">Rule Name</item>
					<item name="formElement" xsi:type="string">input</item>
					<item name="source" xsi:type="string">Rule</item>
					<item name="sortOrder" xsi:type="number">230</item>
					<item name="dataScope" xsi:type="string">name</item>
					<item name="validation" xsi:type="array">
						<item name="required-entry" xsi:type="boolean">true</item>
					</item>
				</item>
			</argument>
		</field>
		<field name="attributes">
			<argument name="data" xsi:type="array">
				<item name="options" xsi:type="object">\PluginCompany\FraudPrevention\Model\Attribute\Source\Attributes</item>
				<item name="config" xsi:type="array">
					<item name="dataType" xsi:type="string">text</item>
					<item name="label" translate="true" xsi:type="string">Rule Attributes</item>
					<item name="formElement" xsi:type="string">multiselect</item>
					<item name="source" xsi:type="string">Rule</item>
					<item name="sortOrder" xsi:type="number">240</item>
					<item name="dataScope" xsi:type="string">attributes</item>
					<item name="validation" xsi:type="array">
						<item name="required-entry" xsi:type="boolean">true</item>
					</item>
					<item name="notice" xsi:type="string" translate="true">Select the attribute(s) to be compared with existing fraud suspicion records when a new order is placed.</item>
				</item>
			</argument>
		</field>
		<field name="strikes">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="dataType" xsi:type="string">text</item>
					<item name="label" translate="true" xsi:type="string">Permitted Strikes</item>
					<item name="formElement" xsi:type="string">input</item>
					<item name="source" xsi:type="string">Rule</item>
					<item name="sortOrder" xsi:type="number">250</item>
					<item name="dataScope" xsi:type="string">strikes</item>
					<item name="validation" xsi:type="array">
						<item name="required-entry" xsi:type="boolean">true</item>
					</item>
					<item name="notice" xsi:type="string" translate="true">Select the attribute(s) to be compared with existing fraud suspicion records when a new order is placed.</item>
				</item>
			</argument>
		</field>
		<field name="status">
			<argument name="data" xsi:type="array">
				<item name="options" xsi:type="array">
					<item name="enabled" xsi:type="array">
						<item name="label" xsi:type="string" translate="true">Enabled</item>
						<item name="value" xsi:type="number">1</item>
					</item>
					<item name="disabled" xsi:type="array">
						<item name="label" xsi:type="string" translate="true">Disabled</item>
						<item name="value" xsi:type="number">0</item>
					</item>
				</item>
				<item name="config" xsi:type="array">
					<item name="dataType" xsi:type="string">text</item>
					<item name="label" translate="true" xsi:type="string">Status</item>
					<item name="formElement" xsi:type="string">select</item>
					<item name="source" xsi:type="string">Rule</item>
					<item name="sortOrder" xsi:type="number">260</item>
					<item name="dataScope" xsi:type="string">status</item>
				</item>
			</argument>
		</field>
	</fieldset>
	<fieldset name="customer_groups">
		<argument name="data" xsi:type="array">
			<item name="config" xsi:type="array">
				<item name="label" xsi:type="string">Customer Groups</item>
				<item name="collapsible" xsi:type="boolean">false</item>
			</item>
		</argument>
		<field name="customer_groups">
			<argument name="data" xsi:type="array">
				<item name="options" xsi:type="object">Magento\Customer\Model\Customer\Source\Group</item>
				<item name="config" xsi:type="array">
					<item name="dataType" xsi:type="string">text</item>
					<item name="label" translate="true" xsi:type="string">Customer Groups</item>
					<item name="formElement" xsi:type="string">multiselect</item>
					<item name="source" xsi:type="string">Rule</item>
					<item name="sortOrder" xsi:type="number">290</item>
					<item name="dataScope" xsi:type="string">customer_groups</item>
					<item name="validation" xsi:type="array">
						<item name="required-entry" xsi:type="boolean">true</item>
					</item>
				</item>
			</argument>
		</field>
	</fieldset>
	<fieldset name="store_views">
		<argument name="data" xsi:type="array">
			<item name="config" xsi:type="array">
				<item name="label" xsi:type="string">Store Views</item>
				<item name="collapsible" xsi:type="boolean">false</item>
			</item>
		</argument>
		<field name="storeviews">
			<argument name="data" xsi:type="array">
				<item name="options" xsi:type="object">Magento\Cms\Ui\Component\Listing\Column\Cms\Options</item>
				<item name="config" xsi:type="array">
					<item name="dataType" xsi:type="string">int</item>
					<item name="label" xsi:type="string" translate="true">Store View</item>
					<item name="formElement" xsi:type="string">multiselect</item>
					<item name="source" xsi:type="string">Form</item>
					<item name="dataScope" xsi:type="string">store_id</item>
					<item name="default" xsi:type="string">0</item>
					<item name="validation" xsi:type="array">
						<item name="required-entry" xsi:type="boolean">true</item>
					</item>
				</item>
			</argument>
		</field>
	</fieldset>
</form>
