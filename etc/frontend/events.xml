<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
  <event name="controller_action_predispatch">
    <observer name="plugincompany_fraudprevention" instance="PluginCompany\FraudPrevention\Observer\LogoutCustomer" shared="false"/>
  </event>
  <event name="sales_quote_address_save_after">
    <observer name="plugincompany_fraudprevention" instance="PluginCompany\FraudPrevention\Observer\CheckCustomerAddressQuote" shared="false"/>
  </event>
  <event name="customer_address_save_after">
    <observer name="plugincompany_fraudprevention" instance="PluginCompany\FraudPrevention\Observer\CheckCustomerAddressAccount" shared="false"/>
  </event>
  <event name="payment_method_is_active">
    <observer name="plugincompany_fraudprevention" instance="PluginCompany\FraudPrevention\Observer\DisablePaymentMethods" shared="false"/>
  </event>
  <event name="sales_model_service_quote_submit_failure">
    <observer name="plugincompany_fraudprevention" instance="PluginCompany\FraudPrevention\Observer\AddFailedPaymentStrike" shared="false"/>
  </event>
</config>