					<item name="label" translate="true" xsi:type="string">Company</item>
					<item name="formElement" xsi:type="string">input</item>
					<item name="source" xsi:type="string">Suspicion</item>
					<item name="dataScope" xsi:type="string">company</item>
					<item name="validation" xsi:type="array">
						<item name="required-entry" xsi:type="boolean">false</item>
					</item>
				</item>
			</argument>
		</field>
		<field name="street">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="dataType" xsi:type="string">text</item>
					<item name="label" translate="true" xsi:type="string">Street</item>
					<item name="formElement" xsi:type="string">textarea</item>
					<item name="source" xsi:type="string">Suspicion</item>
					<item name="dataScope" xsi:type="string">street</item>
					<item name="validation" xsi:type="array">
						<item name="required-entry" xsi:type="boolean">false</item>
