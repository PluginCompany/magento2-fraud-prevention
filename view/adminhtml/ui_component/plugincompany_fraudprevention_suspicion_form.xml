<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">plugincompany_fraudprevention_suspicion_form.suspicion_form_data_source</item>
			<item name="deps" xsi:type="string">plugincompany_fraudprevention_suspicion_form.suspicion_form_data_source</item>
