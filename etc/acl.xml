<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
	<acl>
		<resources>
			<resource id="Magento_Backend::admin">
				<resource id="PluginCompany_FraudPrevention::General" sortOrder="10000" title="Fraud Prevention">
					<resource id="PluginCompany_FraudPrevention::Suspicion" sortOrder="10" title="Suspicion">
						<resource id="PluginCompany_FraudPrevention::Suspicion_save" sortOrder="10" title="Save Suspicion"/>
						<resource id="PluginCompany_FraudPrevention::Suspicion_delete" sortOrder="20" title="Delete Suspicion"/>
						<resource id="PluginCompany_FraudPrevention::Suspicion_update" sortOrder="30" title="Update Suspicion"/>
						<resource id="PluginCompany_FraudPrevention::Suspicion_view" sortOrder="40" title="View Suspicion"/>
					</resource>
					<resource id="PluginCompany_FraudPrevention::Rule" sortOrder="100" title="Rule">
						<resource id="PluginCompany_FraudPrevention::Rule_save" sortOrder="10" title="Save Rule"/>
						<resource id="PluginCompany_FraudPrevention::Rule_delete" sortOrder="20" title="Delete Rule"/>
						<resource id="PluginCompany_FraudPrevention::Rule_update" sortOrder="30" title="Update Rule"/>
						<resource id="PluginCompany_FraudPrevention::Rule_view" sortOrder="40" title="View Rule"/>
					</resource>
					<resource id="PluginCompany_FraudPrevention::Config" sortOrder="1000" title="Store Configuration"/>
				</resource>
			</resource>
		</resources>
	</acl>
</config>
