					<item name="label" translate="true" xsi:type="string">Customer IP</item>
					<item name="formElement" xsi:type="string">input</item>
					<item name="source" xsi:type="string">Suspicion</item>
					<item name="dataScope" xsi:type="string">customer_ip</item>
					<item name="validation" xsi:type="array">
						<item name="required-entry" xsi:type="boolean">false</item>
